# ─────────────────────────────────────────────────────────────────────────────
# Agent Ally — environment variables
# Copy to .env.local for development. The app RUNS WITH ZERO KEYS:
# marketing pages are static; auth/portal/admin show a setup notice until
# Supabase vars are present.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Public URL (used for metadata, sitemap, auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (required for auth, intake, portal, admin) ─────────────────────
# Local stack (`supabase start` prints these):
#   URL:      http://127.0.0.1:54321
#   anon key: printed as "anon key"
# Hosted: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER-ONLY. Never exposed to the browser (no NEXT_PUBLIC_
# prefix, and nothing in src/ imports it client-side). Only needed for future
# server-side jobs; the app currently does NOT require it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Scheduling (optional) ────────────────────────────────────────────────────
# Calendly (or similar) link for the free fit call. Shown on /apply when set.
NEXT_PUBLIC_CALENDLY_URL=

# ── Email notifications (optional — stubbed to console logs without keys) ───
RESEND_API_KEY=
EMAIL_FROM="Agent Ally <hello@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=

# ── Stripe (optional — scaffold only; not required for validation) ──────────
# Simplest validation path: create a Stripe Payment Link for the $950 audit
# and paste it here. Programmatic checkout (lib/stripe.ts) needs the others.
NEXT_PUBLIC_STRIPE_AUDIT_PAYMENT_LINK=
STRIPE_SECRET_KEY=
STRIPE_AUDIT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Analytics (optional, privacy-friendly) ──────────────────────────────────
# Set to your domain (e.g. agentally.co) to enable Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
